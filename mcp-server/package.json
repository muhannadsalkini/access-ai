{
  "name": "accessai-mcp",
  "version": "1.3.0",
  "description": "MCP server for AccessAI — AI-powered web accessibility scanning and analysis for developer agents (Cursor, Cline, Claude Code, etc.)",
  "main": "dist/index.js",
  "bin": {
    "accessai-mcp": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "accessibility",
    "wcag",
    "a11y",
    "axe-core",
    "ai",
    "cursor",
    "cline",
    "claude-code",
    "model-context-protocol"
  ],
  "author": "AccessAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/muhannadsalkini/access-ai.git",
    "directory": "mcp-server"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
