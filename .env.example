# ============================================
# AccessAI Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google AI (Gemini) ---
GOOGLE_API_KEY=your-google-api-key

# --- Backend ---
BACKEND_PORT=3001
AGENT_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# HMAC secret for API key hashing — REQUIRED in production (HIGH-03 fix).
# Generate with: openssl rand -hex 32
# WARNING: Changing this value invalidates all existing API keys.
API_KEY_SECRET=your-api-key-hmac-secret-here

# Specific Chrome extension origin allowed by CORS — REQUIRED in production (HIGH-05 fix).
# Set to your exact Chrome extension ID, e.g.:
# EXTENSION_ORIGIN=chrome-extension://ckbcbmdcpackkggjhnbiicjkaipmkhoi
# In development this can be left blank (all chrome-extension:// origins are allowed).
EXTENSION_ORIGIN=

# --- Backend ↔ Agent shared secret (REQUIRED in production) ---
# Both services must have the same value.  Generate with: openssl rand -hex 32
AGENT_INTERNAL_SECRET=your-random-secret-here   # set in backend env as AGENT_INTERNAL_SECRET
INTERNAL_SECRET=your-random-secret-here          # set in agent env as INTERNAL_SECRET

# --- Agent ---
AGENT_PORT=8000
BACKEND_SERVICE_URL=http://localhost:3001

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
